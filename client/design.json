{
    "style_guide": {
        "name": "Lululemon App Inspired Theme",
        "version": "1.0",
        "description": "A style guide inspired by the clean, premium, and minimalist aesthetic of the Lululemon mobile app.",
        "aesthetic_keywords": [
            "Clean",
            "Minimalist",
            "Premium",
            "Personal",
            "Spacious"
        ],
        "color_palette": {
            "background": {
                "primary": "#FFFFFF",
                "description": "Used for the main screen background."
            },
            "surface": {
                "primary": "#F7F7F7",
                "description": "Slightly off-white used for cards and contained elements like search bars."
            },
            "text": {
                "primary": "#000000",
                "description": "For main headings and important text."
            },
            "text_secondary": {
                "primary": "#6D6E71",
                "description": "For sub-headings, labels, and less important text."
            },
            "accent": {
                "primary": "#D82934",
                "description": "Signature red for active states and highlights."
            },
            "accent_secondary": {
                "primary": "#3A7BD5",
                "description": "Blue used for interactive elements like progress bars."
            },
            "border": {
                "primary": "#EAEAEA",
                "description": "Subtle borders for components and dividers."
            }
        },
        "typography": {
            "font_family": "Modern Sans-Serif (e.g., Helvetica Neue, Calibre, or similar)",
            "styles": [
                {
                    "name": "display_heading",
                    "description": "For personalized greetings like 'Hi Alex'.",
                    "font_size": "28pt",
                    "font_weight": "700"
                },
                {
                    "name": "section_title",
                    "description": "For titles like 'Your Recent Orders'.",
                    "font_size": "18pt",
                    "font_weight": "700"
                },
                {
                    "name": "body_primary",
                    "description": "Standard body text.",
                    "font_size": "16pt",
                    "font_weight": "400"
                },
                {
                    "name": "body_secondary",
                    "description": "For secondary information like the 'FYI' banner.",
                    "font_size": "14pt",
                    "font_weight": "400",
                    "color": "text_secondary"
                },
                {
                    "name": "label",
                    "description": "For small labels like 'Processing'.",
                    "font_size": "12pt",
                    "font_weight": "400",
                    "color": "text_secondary"
                }
            ]
        },
        "layout_and_spacing": {
            "base_unit": "8px",
            "screen_padding": "16px",
            "section_spacing": "24px",
            "alignment": "left",
            "principles": [
                "Use generous whitespace to create a feeling of openness.",
                "Maintain consistent padding within components.",
                "Use a strong vertical axis to align text and elements."
            ]
        },
        "component_styles": {
            "card": {
                "background_color": "surface.primary",
                "border_radius": "12px",
                "padding": "16px",
                "shadow": "none",
                "border": "1px solid var(--border-primary)"
            },
            "search_bar": {
                "background_color": "surface.primary",
                "border_radius": "8px",
                "height": "48px",
                "padding": "0 12px"
            },
            "icons": {
                "style": "line-art",
                "stroke_width": "1.5px",
                "size": "24px",
                "color": "text_secondary",
                "active_color": "text_primary"
            },
            "navigation": {
                "tab_indicator": "A thin, solid underline in the primary accent color.",
                "bottom_nav_background": "background.primary",
                "bottom_nav_top_border": "1px solid var(--border-primary)"
            }
        }
    }
}